#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT_DIR"

./scripts/setup

find src scripts -type f \( -name '*.js' -o -name '*.mjs' \) -print |
  while IFS= read -r file; do
    node --check "$file"
  done

if grep -RInE '[[:blank:]]+$' README.md index.html src scripts package.json --exclude-dir=node_modules; then
  echo "错误：发现行尾空白。" >&2
  exit 1
fi

echo "静态检查通过。"
